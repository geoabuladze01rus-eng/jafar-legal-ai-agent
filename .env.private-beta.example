# JAFAR / ЮСТИЦИЯ AI — Private Beta production template
# Copy to the deployment secret store; never commit the populated file.
# For the staging rehearsal, set ENVIRONMENT=staging and use a separate Supabase project.
# Do not reuse production URL, owner, bucket, service-role key, or provider credentials.

# Core runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
API_KEY=replace-with-a-random-24-plus-character-secret
LAWYER_APPROVER_ID=replace-with-the-server-configured-approver-identity
STORAGE_BACKEND=supabase

# Supabase (service-role key is backend-only; never ship it in Apple/web clients)
JAFAR_SUPABASE_URL=https://your-project.supabase.co
JAFAR_SUPABASE_ANON_KEY=replace-with-client-safe-key-if-needed
JAFAR_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret
JAFAR_SUPABASE_OWNER_USER_ID=replace-with-controlled-beta-owner-uuid

# AI queue and distributed request limiting
AI_QUEUE_BACKEND=supabase
AI_QUEUE_MAX_SIZE=1000
AI_QUEUE_MAX_PER_USER=20
AI_QUEUE_WORKER_CLAIM_LIMIT=5
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# AI cost controls (required in production; use reviewed current pricing)
AI_COST_CONTROL_ENABLED=true
AI_PRICING_JSON=replace-with-reviewed-json-pricing
AI_PRICING_VERSION=2026-08-29-reviewed
AI_COST_PER_REQUEST_USD=replace-with-ceiling
AI_COST_USER_DAILY_USD=replace-with-ceiling
AI_COST_USER_MONTHLY_USD=replace-with-ceiling
AI_COST_MATTER_DAILY_USD=replace-with-ceiling
AI_COST_MATTER_MONTHLY_USD=replace-with-ceiling
AI_COST_GLOBAL_DAILY_USD=replace-with-ceiling

# Provider credentials and models (enable only reviewed providers)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6
OPENAI_API_KEY=replace-with-secret
OPENAI_MODEL=gpt-5.6
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
KIMI_MODEL=kimi-k3
ALIBABA_MODEL_STUDIO_CHAT_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1/chat/completions
AI_TRUSTED_PROVIDER_HOSTS=

# Document storage and retention policy (enforced by deployment/storage operations)
# The application stores document metadata through Supabase; keep source files in the
# approved private bucket and document the retention/deletion job before onboarding users.
DOCUMENT_STORAGE_BUCKET=jafar-legal-documents
DOCUMENT_RETENTION_DAYS=90

# Apple client runtime (configure in Xcode scheme/Info.plist, never with service secrets)
JAFAR_API_BASE_URL=https://your-private-beta-api.example
# JAFAR_API_TOKEN is for local scheme injection only; production users enter a token
# into the Keychain-backed connection settings screen.

# Optional integrations stay disabled unless separately reviewed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_PRODUCTION_SEND=false
TELEGRAM_DRY_RUN=true
