ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=replace-me
STORAGE_BACKEND=memory
# Production approval audit identity. The backend uses this value instead of trusting a client-supplied name.
LAWYER_APPROVER_ID=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6

# JAFAR Cost & Scale Control
# Keep disabled for simple local development. Commercial production must enable this with
# reviewed provider pricing, a pricing-version label and explicit spend ceilings. Prices are USD
# per 1M tokens and are configuration, not source-code constants, because provider tariffs change.
AI_COST_CONTROL_ENABLED=false
AI_PRICING_JSON=
AI_PRICING_VERSION=
AI_COST_PER_REQUEST_USD=
AI_COST_USER_DAILY_USD=
AI_COST_USER_MONTHLY_USD=
# Matter ceilings prevent one unusually large case from consuming the whole user/global budget.
AI_COST_MATTER_DAILY_USD=
AI_COST_MATTER_MONTHLY_USD=
AI_COST_GLOBAL_DAILY_USD=
# Example only (do not treat these numbers as current vendor prices):
# AI_PRICING_JSON={"openai":{"*":{"input":"1.00","cached_input":"0.10","output":"4.00"}},"deepseek":{"*":{"input":"0.50","output":"1.00"}}}
# AI_PRICING_VERSION=2026-08-28-reviewed

# AI job queue
# Local development may use memory. Commercial production must use the durable Supabase queue
# so multiple API/worker instances atomically claim work instead of duplicating expensive calls.
AI_QUEUE_BACKEND=memory
AI_QUEUE_MAX_SIZE=1000
AI_QUEUE_MAX_PER_USER=20
AI_QUEUE_WORKER_CLAIM_LIMIT=5

# AI request rate limiting. Production uses owner-scoped Supabase counters shared by all API nodes.
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Persistent legal matter + approval + AI usage/cost storage (required in production)
# Never expose the service-role key to Apple/web clients or commit a real value.
JAFAR_SUPABASE_URL=
JAFAR_SUPABASE_ANON_KEY=
JAFAR_SUPABASE_SERVICE_ROLE_KEY=
JAFAR_SUPABASE_OWNER_USER_ID=

# AI provider transport security
# Built-in trusted hosts cover OpenAI, DeepSeek, Google Gemini and Alibaba Model Studio.
# Add only reviewed enterprise/provider gateway hostnames here; arbitrary endpoints receive both
# confidential prompts and provider credentials and therefore fail closed by default.
AI_TRUSTED_PROVIDER_HOSTS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# DeepSeek (direct API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Alibaba Cloud Model Studio (Qwen + Kimi)
DASHSCOPE_API_KEY=
# Production: replace with the OpenAI-compatible chat/completions endpoint for your region/workspace.
# If a private enterprise gateway is used, add only its reviewed hostname to AI_TRUSTED_PROVIDER_HOSTS.
ALIBABA_MODEL_STUDIO_CHAT_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.8-max
KIMI_MODEL=kimi-k3
