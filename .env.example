ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=replace-me
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6

# Telegram / MCP
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_PRODUCTION_SEND=false
TELEGRAM_DRY_RUN=true
TELEGRAM_SCHEDULER_DB_PATH=./data/telegram.sqlite3
# Set true only when scheduler runs in the FastAPI process. For standalone MCP,
# run `python -m jafar.telegram_scheduler_worker` under a service manager instead.
TELEGRAM_SCHEDULER_ENABLED=false

# MCP transport: stdio for local Inspector, streamable-http for remote clients
JAFAR_MCP_TRANSPORT=stdio
JAFAR_MCP_HOST=127.0.0.1
JAFAR_MCP_PORT=8000
# Required for any non-local streamable HTTP listener. Keep this secret out of Git.
JAFAR_MCP_AUTH_TOKEN=
# Public HTTPS MCP URL, used only with authenticated remote MCP.
JAFAR_MCP_PUBLIC_URL=
