ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=replace-me
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# DeepSeek (direct API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Alibaba Cloud Model Studio (Qwen + Kimi)
DASHSCOPE_API_KEY=
# Replace with the OpenAI-compatible chat/completions endpoint for your selected region/workspace.
ALIBABA_MODEL_STUDIO_CHAT_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.7-max
KIMI_MODEL=kimi-k3
