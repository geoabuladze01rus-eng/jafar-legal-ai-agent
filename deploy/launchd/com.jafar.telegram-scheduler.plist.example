<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jafar.telegram-scheduler</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd __JAFAR_REPO__ &amp;&amp; exec .venv/bin/python -m jafar.telegram_scheduler_worker</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__JAFAR_REPO__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__JAFAR_REPO__/var/telegram-scheduler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__JAFAR_REPO__/var/telegram-scheduler.stderr.log</string>
</dict>
</plist>
