ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=replace-me
EXTERNAL_AI_ENABLED=false
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6
JAFAR_OCR_MODEL=gpt-5.6
JAFAR_ANALYSIS_MODEL=gpt-5.6
JAFAR_EMBEDDING_MODEL=text-embedding-3-small
JAFAR_OCR_MAX_RETRIES=3
JAFAR_PIPELINE_MAX_RETRIES=3
JAFAR_OPENAI_MAX_ATTEMPTS=3
JAFAR_OPENAI_TIMEOUT_MS=90000
JAFAR_EMBEDDING_BATCH_SIZE=100
JAFAR_ANALYSIS_MAX_CONTEXT_CHARS=700000

# Edge Function secrets (placeholders only; provision real values in Supabase).
JAFAR_WORKER_SECRET=replace-with-a-random-worker-secret
OPENAI_API_KEY=replace-me
