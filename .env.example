ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=replace-me
STORAGE_BACKEND=memory
# Production approval audit identity. The backend uses this value instead of trusting a client-supplied name.
LAWYER_APPROVER_ID=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6

# Persistent legal matter storage (required in production)
# Never expose the service-role key to Apple/web clients or commit a real value.
JAFAR_SUPABASE_URL=
JAFAR_SUPABASE_ANON_KEY=
JAFAR_SUPABASE_SERVICE_ROLE_KEY=
JAFAR_SUPABASE_OWNER_USER_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# DeepSeek (direct API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Alibaba Cloud Model Studio (Qwen + Kimi)
DASHSCOPE_API_KEY=
# Production: replace with the OpenAI-compatible chat/completions endpoint for your region/workspace.
ALIBABA_MODEL_STUDIO_CHAT_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.8-max
KIMI_MODEL=kimi-k3
