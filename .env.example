ENVIRONMENT=development
LOG_LEVEL=INFO
# Legacy application setting. This does NOT protect the HTTP API.
API_KEY=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6
OPENAI_API_KEY=

# Local-first private AI on the user's Mac.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_HEALTH_TIMEOUT_SECONDS=0.35
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false
# Keep confidential legal text local by default. Enable only with explicit consent.
CONFIDENTIAL_CLOUD_FALLBACK=false

JAFAR_SUPABASE_URL=
JAFAR_SUPABASE_SERVICE_ROLE_KEY=
JAFAR_LEGAL_RESEARCH_OWNER_USER_ID=
# Required for every /v1 route in staging/production. If missing, the API fails closed with 401.
JAFAR_API_BEARER_TOKEN=
# Google OAuth broker (production)
JAFAR_GOOGLE_OAUTH_CLIENT_ID=
JAFAR_GOOGLE_OAUTH_CLIENT_SECRET=
JAFAR_GOOGLE_OAUTH_REDIRECT_URI=
JAFAR_GOOGLE_OAUTH_STATE_SECRET=
JAFAR_GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional short-lived development fallback tokens.
JAFAR_GOOGLE_ACCESS_TOKEN=
JAFAR_GMAIL_ACCESS_TOKEN=
JAFAR_GOOGLE_CALENDAR_ACCESS_TOKEN=

# Telegram command bridge. Keep live send disabled until the owner smoke test.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_SCHEDULER_ENABLED=false
TELEGRAM_SCHEDULER_DB_PATH=var/telegram_scheduler.sqlite3
TELEGRAM_POLL_IDENTITY_SECRET=
TELEGRAM_PRODUCTION_SEND=false
TELEGRAM_DRY_RUN=true
TELEGRAM_EDITORIAL_MODE=APPROVE
TELEGRAM_OWNER_APPROVER_ID=

# Remote MCP: bind locally and expose only through an authenticated HTTPS proxy/tunnel.
JAFAR_MCP_TRANSPORT=stdio
JAFAR_MCP_HOST=127.0.0.1
JAFAR_MCP_PORT=8000
JAFAR_MCP_AUTH_TOKEN=
JAFAR_MCP_PUBLIC_URL=
