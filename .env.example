ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=replace-me
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6

# Local-first private AI on the user's Mac.
OLLAMA_ENABLED=true
